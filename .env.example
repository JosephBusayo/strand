# Copy to .env.local and fill in. Never commit real values.

# PayPal (Sandbox app: developer.paypal.com > Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created after the first deploy
PAYPAL_WEBHOOK_ID=

# Sandbox personal account, shown on the demo hub. Sandbox values only.
DEMO_SANDBOX_BUYER_EMAIL=
DEMO_SANDBOX_BUYER_PASSWORD=

# AI (key from aistudio.google.com)
# Models are set in src/server/ai/model.ts, with a backup for when the free quota runs out.
GOOGLE_GENERATIVE_AI_API_KEY=

# Supabase (Project Settings). Use the pooler connection string for DATABASE_URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=acag

# App
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
